# Next.js Environment Variables Example Template

# Backend API V1 Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Application Details
NEXT_PUBLIC_APP_NAME=FreshVana Organic Marketplace
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer Support Contact Details
NEXT_PUBLIC_SUPPORT_PHONE=918707375679
NEXT_PUBLIC_SUPPORT_EMAIL=support@freshvana.com

# Enable Offline / Demo Fallback Mode (true/false)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false
